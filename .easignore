# EAS Build archive rules. This file intentionally does not inherit the
# repository's broad `*.js` and `package.json` Git ignores because those are
# required to build the mobile workspace in the cloud.

# Dependencies and package-manager state
node_modules/
**/node_modules/
.pnp
.pnp.js
package-lock.json

# Generated build and test output
.expo/
**/.expo/
.expo-*/
**/.expo-*/
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/
.turbo/
**/.turbo/
tmp/
**/tmp/
web-build/
**/web-build/
apps/mobile/android/
apps/mobile/ios/

# Secrets and signing material
.env
.env.*
**/.env
**/.env.*
apps/functions/service-account.json
*.jks
*.p12
*.key
*.pem
*.mobileprovision

# Local tooling and logs
.git/
.github/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log
expo-8081-error.log
expo-8081.log
.local-mobile.err.log
.local-mobile.out.log
.local-web.err.log
.local-web.out.log
response2.txt
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
docs/

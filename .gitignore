# New Manager mobile components required by Expo production builds.
# Keep the broader generated/source ignore rules above, but allow these
# imported modules to be committed so EAS receives them.
!/apps/mobile/components/
/apps/mobile/components/*
!/apps/mobile/components/manager/
/apps/mobile/components/manager/*
!/apps/mobile/components/manager/AdminMobileSettingsEditor.js
!/apps/mobile/components/manager/ManagerQuickAccess.js
!apps/functions/src/invoices/financeInvoiceProjection.js
!apps/functions/src/invoices/upsertFinanceInvoice.js
!apps/functions/test/financeInvoiceProjection.test.js
!apps/functions/test/shipmentSenderOptional.test.js
!apps/functions/src/notifications/processCustomerNotificationJob.js
!/apps/mobile/components/manager/ManagerTripScheduleModal.js

# Scanner timing/queue logic and its focused regression test are source files.
!/apps/mobile/components/utilities/
/apps/mobile/components/utilities/*
!/apps/mobile/components/utilities/scanPerformance.js
!/apps/mobile/components/utilities/scanPerformance.test.cjs

# Quick Access Expo Router screens must also be present in the EAS checkout.
!/apps/mobile/app/(checker)/(tabs)/quick/
!/apps/mobile/app/(checker)/(tabs)/quick/*.js
!/apps/mobile/app/(checker)/(tabs)/quick/management/
!/apps/mobile/app/(checker)/(tabs)/quick/management/*.js
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat

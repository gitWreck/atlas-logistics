rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ===============================
       AUTH HELPERS
    =============================== */
    function signedIn() { return request.auth != null; }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUser() { return signedIn() && exists(userPath()); }
    function user() { return hasUser() ? get(userPath()).data : null; }
    function role() { return user() != null ? user().role : null; }
    function active() { return hasUser() && user().active == true; }

    function isStaff() {
      return active() &&
        (role() == "admin" ||
         role() == "manager" ||
         role() == "driver" ||
         role() == "checker");
    }

    /* ===============================
       USERS
    =============================== */
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || role() == "admin");
      allow list: if role() == "admin";
      allow update: if request.auth.uid == uid;
      allow create, delete: if false;
    }

    /* ===============================
       TRACKING RECORDS (LOADBOARD SAFE)
    =============================== */
    match /tracking_records/{id} {

      // Single doc visibility
      allow get: if resource.data.public == true || isStaff();

      // 🔥 Allow public loadboard + trip filtering
      allow list: if
        isStaff()
        ||
        (
          request.query.limit != null &&
          (
            request.query.where("public", "==", true) ||
            request.query.where("tripId", "==", "T-07")
          )
        );

      allow create, update, delete: if false;

      match /status_events/{eid} {
        allow get, list: if isStaff();
      }

      match /truck_trips/{tripId} {
        allow get, list: if isStaff();

        match /trip_packages/{pkgId} {
          allow get, list: if isStaff();
        }
      }
    }

    /* ===============================
       PUBLIC TRIP VIEW
    =============================== */
    match /truck_trips/{tripId} {

      allow get: if resource.data.public == true || isStaff();
      allow list: if isStaff();

      match /trip_packages/{pkgId} {
        allow get: if resource.data.public == true || isStaff();
        allow list: if isStaff();

        match /status_events/{eid} {
          allow get, list: if resource.data.public == true || isStaff();
        }
      }
    }

    /* ===============================
       PRIVATE SYSTEM DATA
    =============================== */
    match /tracking_private/{id} {
      allow read, write: if role() == "admin" || role() == "manager";
    }

    match /sms_logs/{id} {
      allow read, write: if role() == "admin" || role() == "manager";
    }

    match /audit_logs/{id} {
      allow read: if role() == "admin" || role() == "manager";
    }

    /* ===============================
       DENY EVERYTHING ELSE
    =============================== */
    match /{doc=**} {
      allow read, write: if false;
    }
  }
}

{
  "expo": {
    "name": "Atlas Transport",
    "slug": "atlas-transport",
    "version": "1.0.2",
    "scheme": "atlastrucking",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#ffffff",
      "imageWidth": 100
    },
    "ios": {
      "buildNumber": "6",
      "supportsTablet": true,
      "bundleIdentifier": "com.atlas.tracking",
      "config": {
        "googleMapsApiKey": "AIzaSyD2-cgUlA9g4PyV9Zwrx17L5EFyQoTDkQo"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Atlas uses the camera to scan package QR codes, capture proof-of-delivery photos, and support video calls.",
        "NSMicrophoneUsageDescription": "Atlas uses the microphone for voice and video calls.",
        "NSLocationWhenInUseUsageDescription": "Atlas uses your location to update package tracking and trip progress while you are on the road.",
        "NSPhotoLibraryUsageDescription": "Atlas accesses your photos so you can attach proof-of-delivery images and shipment documents to a delivery record."
      }
    },
    "android": {
      "package": "com.atlas.atlastracking",
      "versionCode": 28,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD2-cgUlA9g4PyV9Zwrx17L5EFyQoTDkQo"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ec8f27c9-8cdf-4b23-9287-63a396bb6cff"
      }
    },
    "owner": "atlas-corporation",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Atlas uses the camera to scan package QR codes and capture proof-of-delivery photos when you complete a shipment."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Atlas Transport to access your microphone so you can record voice messages."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Atlas uses the camera to scan package QR codes and capture proof-of-delivery photos when you complete a shipment.",
          "photosPermission": "Atlas accesses your photos so you can attach proof-of-delivery images and shipment documents to a delivery record.",
          "colors": {
            "cropToolbarColor": "#000000"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#000000"
            }
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ec8f27c9-8cdf-4b23-9287-63a396bb6cff"
    }
  }
}

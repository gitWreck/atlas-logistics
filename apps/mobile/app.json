{
  "expo": {
    "name": "Atlas Transport",
    "slug": "atlas-transport",
    "version": "1.0.0",
    "scheme": "atlastrucking",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "imageWidth": 200
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atlas.atlastracking",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Atlas uses your location to update package tracking and trip progress while you are on the road."
      }
    },
    "android": {
      "package": "com.atlas.atlastracking",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD2-cgUlA9g4PyV9Zwrx17L5EFyQoTDkQo"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "origin": false
      }
    },
    "owner": "atlas-transport",
    "plugins": ["expo-router", "expo-font"],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {}
  }
}

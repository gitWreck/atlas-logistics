rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function hasAnyRole(roles) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    function isAssignedDriver() {
      return resource.data.driverId == request.auth.uid;
    }

    function customerCanSeeShipment() {
      return hasRole('customer')
        && resource.data.keys().hasAll(['visibilityUserIds'])
        && request.auth.uid in resource.data.visibilityUserIds;
    }

    // Customer signup runs email / identity duplicate queries before auth exists.
    // Queries must use where(...) and limit(1) so the potential result set stays tiny.
    function isCustomerSignupDuplicateQuery() {
      return !isSignedIn()
        && request.query.limit != null
        && request.query.limit <= 1;
    }

    // --- Single users tree (no duplicate match /users blocks) ---
    match /users/{userId} {
      function canReadUserProfile() {
        return isSignedIn() && (
          request.auth.uid == userId ||
          hasRole('admin') ||
          hasRole('manager') ||
          hasRole('checker') ||
          hasRole('driver')
        );
      }

      allow get: if canReadUserProfile();
      allow list: if isCustomerSignupDuplicateQuery() || canReadUserProfile();

      // Self-service profile writes only for the document owner; staff can manage users
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isSignedIn() && (
        request.auth.uid == userId ||
        hasRole('admin') ||
        hasRole('manager')
      );

      // Canonical path (matches addTrackedShipment Cloud Function)
      match /tracked_shipments/{trackingNumber} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Legacy camelCase path — keep until data migrated, then remove this block
      match /trackedShipments/{trackingNumber} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }

      match /pushTokens/{tokenId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /conversations/{conversationId} {
      allow read: if hasAnyRole(['admin', 'manager'])
        || (isSignedIn() && resource.data.customerId == request.auth.uid)
        || (isSignedIn() && request.auth.uid in resource.data.participantIds);

      // All chat writes go through Cloud Functions so unread counts,
      // assignment, notifications, and message metadata stay consistent.
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if hasAnyRole(['admin', 'manager'])
          || (
            isSignedIn()
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid
          )
          || (
            isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          );

        allow create, update, delete: if false;
      }
    }

    match /shipments/{shipmentId} {
      allow read: if isSignedIn() && (
        hasRole('admin') ||
        hasRole('manager') ||
        hasRole('checker') ||
        hasRole('driver') ||
        customerCanSeeShipment()
      );

      allow write: if hasRole('checker');

      match /status_events/{statusId} {
        allow read: if hasRole('checker');
        allow write: if hasRole('checker');
      }
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn() &&
        (hasRole('admin') || hasRole('manager') || hasRole('checker') || hasRole('driver'));
      allow write: if hasRole('admin') || hasRole('manager');
    }

    match /tracking_records/{trackingNumber} {
      allow read: if hasRole('admin') || hasRole('manager') || hasRole('checker') || hasRole('driver');
      allow write: if false;
    }

    match /truck_trips/{tripId} {
      allow read: if hasRole('admin') || hasRole('manager') || hasRole('checker') || hasRole('driver');
      allow write: if hasRole('checker') || hasRole('driver');

      match /trip_shipments/{shipmentId} {
        allow read: if hasRole('checker') || hasRole('driver');
        allow write: if hasRole('checker') || hasRole('driver');
      }
    }

    match /tracking_public/{trackingNumber} {
      allow read: if true;
      allow write: if false;
    }

    match /sms_logs/{smsId} {
      allow read: if isSignedIn() && (hasRole('admin') || hasRole('manager'));
      allow write: if false;
    }

    match /admin_alerts/{alertId} {
      allow read: if isSignedIn() && (hasRole('admin') || hasRole('manager'));
      allow write: if isSignedIn() && (hasRole('admin') || hasRole('manager'));
    }

    match /audit_logs/{logId} {
      allow read: if hasRole('admin');
      allow write: if hasRole('checker');
    }

    match /admin_logs/{logId} {
      allow read: if isSignedIn() && (hasRole('admin') || hasRole('manager'));
      allow write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userDocPath());
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(userDocPath())
        && userDoc().data.get('active', true) != false;
    }

    function userRole() {
      return userDoc().data.get('role', '').lower();
    }

    function hasRole(role) {
      return isActiveUser() && userRole() == role.lower();
    }

    function hasAnyRole(roles) {
      return isActiveUser() && userRole() in roles;
    }

    function isStaff() {
      return hasAnyRole(['admin', 'manager', 'checker', 'driver']);
    }

    function isAdminOrManager() {
      return hasAnyRole(['admin', 'manager', 'administrator']);
    }

    function isAdmin() {
      return hasAnyRole(['admin', 'administrator']);
    }

    function managerWarehouseCode() {
      return userDoc().data.get('warehouseCode',
        userDoc().data.get('assignedWarehouseCode', ''));
    }

    function managerWarehouseId() {
      return userDoc().data.get('warehouseId',
        userDoc().data.get('assignedWarehouseId', ''));
    }

    function managerWarehouseName() {
      return userDoc().data.get('warehouseName',
        userDoc().data.get('assignedWarehouseName', ''));
    }

    function managerHasWarehouseAssignment() {
      return managerWarehouseCode() != ''
        || managerWarehouseId() != ''
        || managerWarehouseName() != '';
    }

    function managerMunicipalities() {
      return userDoc().data.get('assignedMunicipalities',
        userDoc().data.get('municipalityCoverage', []));
    }

    // Manager client reads require a matching warehouse assignment. Server
    // callables repeat and broaden this normalization for legacy field names.
    function managerCanAccessOperation(data) {
      return hasRole('manager')
        && managerHasWarehouseAssignment()
        && (
          managerWarehouseCode() in [
            data.get('warehouseCode', ''),
            data.get('assignedWarehouseCode', ''),
            data.get('currentWarehouseCode', ''),
            data.get('originCode', ''),
            data.get('destinationCode', '')
          ]
          || managerWarehouseId() in [
            data.get('warehouseId', ''),
            data.get('assignedWarehouseId', ''),
            data.get('currentWarehouseId', ''),
            data.get('originWarehouseId', ''),
            data.get('destinationWarehouseId', '')
          ]
          || managerWarehouseName() in [
            data.get('warehouseName', ''),
            data.get('assignedWarehouseName', ''),
            data.get('currentWarehouseName', ''),
            data.get('origin', ''),
            data.get('destination', '')
          ]
        )
        && (
          managerMunicipalities().size() == 0
          || data.get('municipality', '') == ''
          || data.get('municipality', '') in managerMunicipalities()
        );
    }

    function managerCanAccessConversation(conversation) {
      let shipmentId = conversation.get('shipmentId',
        conversation.get('trackingNumber', ''));
      return hasRole('manager') && (
        request.auth.uid in conversation.get('participantIds', [])
        || conversation.get('assignedTo', '') == request.auth.uid
        || conversation.get('assignedStaffId', '') == request.auth.uid
        || (
          shipmentId != ''
          && exists(/databases/$(database)/documents/shipments/$(shipmentId))
          && managerCanAccessOperation(
            get(/databases/$(database)/documents/shipments/$(shipmentId)).data
          )
        )
      );
    }

    function isAnonymousUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function ownsConversation(conversation) {
      return conversation.customerId == request.auth.uid;
    }

    // Website live chat: any signed-in user (including anonymous / missing profile)
    // can read conversations they own. Writes still go through Cloud Functions.
    function canReadOwnedConversation(conversation) {
      return isSignedIn() && ownsConversation(conversation);
    }

    function isAssignedDriver() {
      return resource.data.driverId == request.auth.uid ||
        resource.data.assignedDriverId == request.auth.uid;
    }

    function driverCanReadShipmentData(shipment) {
      return hasRole('driver') && (
        shipment.get('driverId', null) == request.auth.uid ||
        shipment.get('assignedDriverId', null) == request.auth.uid ||
        (
          shipment.get('currentTripId', null) != null &&
          get(/databases/$(database)/documents/truck_trips/$(shipment.get('currentTripId', ''))).data.get('driverId', null) == request.auth.uid
        )
      );
    }

    function customerOwnsShipment() {
      return hasRole('customer') && (
        resource.data.get('sender', {}).get('uid', null) == request.auth.uid ||
        resource.data.get('recipient', {}).get('uid', null) == request.auth.uid ||
        resource.data.get('createdBy', null) == request.auth.uid ||
        resource.data.get('customerId', null) == request.auth.uid
      );
    }

    function canReadDeliveryManifest() {
      return isAdmin() || managerCanAccessOperation(resource.data) ||
        (hasRole('checker') && resource.data.checkerId == request.auth.uid);
    }

    function canReadUserProfile(userId) {
      return isSignedIn() && (
        (
          request.auth.uid == userId
          && (!exists(userDocPath()) || userDoc().data.get('active', true) != false)
        ) ||
        isAdmin()
        || managerCanAccessOperation(resource.data)
      );
    }

    function checkerChatAccessToken() {
      return request.auth.uid + ':' + userDoc().data.get('checkerChatAccessKey', '__missing__');
    }

    function driverChatAccessToken() {
      return request.auth.uid + ':' + userDoc().data.get('driverChatAccessKey', '__missing__');
    }

    function canReadDirectStaffConversation(conversation) {
      return isActiveUser()
        && conversation.get('type', '') == 'direct_staff'
        && request.auth.uid in conversation.get('participantIds', [])
        && (
          userRole() != 'checker'
          || checkerChatAccessToken() in conversation.get('checkerAccessTokens', [])
        )
        && (
          userRole() != 'driver'
          || driverChatAccessToken() in conversation.get('driverAccessTokens', [])
        );
    }

    function canListParticipantConversation(conversation) {
      return isActiveUser() && (
        (
          conversation.get('type', '') == 'direct_staff'
          && userRole() == 'driver'
          && driverChatAccessToken() in conversation.get('driverAccessTokens', [])
        )
        || (
          conversation.get('type', '') == 'direct_staff'
          && userRole() == 'checker'
          && checkerChatAccessToken() in conversation.get('checkerAccessTokens', [])
        )
        || (
          request.auth.uid in conversation.get('participantIds', [])
          && (
            conversation.get('type', '') != 'direct_staff'
            || canReadDirectStaffConversation(conversation)
          )
        )
      );
    }

    function callDriverAssignmentIsCurrent(call) {
      let driverId = call.get('driverId', '');
      return driverId == '' || (
        exists(/databases/$(database)/documents/users/$(driverId))
        && driverId + ':' + get(/databases/$(database)/documents/users/$(driverId)).data.get('driverChatAccessKey', '__missing__')
          in call.get('driverAccessTokens', [])
      );
    }

    // Customer signup currently performs duplicate checks before auth.
    // Keep this tightly limited; moving this check behind a callable/API is safer.
    function isCustomerSignupDuplicateQuery() {
      return !isSignedIn()
        && request.query.limit != null
        && request.query.limit <= 1;
    }

    // --- USERS ---

    match /users/{userId} {
      allow get: if canReadUserProfile(userId);
      allow list: if canReadUserProfile(userId) || isCustomerSignupDuplicateQuery();

      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isActiveUser() && (
        request.auth.uid == userId ||
        isAdmin()
      );
      allow delete: if hasRole('admin');

      // Canonical path used by addTrackedShipment.
      match /tracked_shipments/{trackingNumber} {
        allow read, write: if isActiveUser() && request.auth.uid == userId;
      }

      // Legacy path kept until existing data is migrated.
      match /trackedShipments/{trackingNumber} {
        allow read, write: if isActiveUser() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read: if isActiveUser()
          && request.auth.uid == userId
          && resource.data.get('ownerId', userId) == request.auth.uid;
        allow update: if isActiveUser()
          && request.auth.uid == userId
          && resource.data.get('ownerId', userId) == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }

      match /pushTokens/{tokenId} {
        allow read, create, update, delete: if isActiveUser() && request.auth.uid == userId;
      }
    }

    // --- CUSTOMER SUPPORT CHAT ---

    match /conversations/{conversationId} {
      // Admins/managers can see the full support inbox (including unassigned
      // website guest chats). Guests/customers can read conversations they own.
      // Direct staff threads stay scoped to participants.
      allow get: if isAdmin()
        || managerCanAccessConversation(resource.data)
        || canReadDirectStaffConversation(resource.data)
        || canReadOwnedConversation(resource.data)
        || (hasRole('employee') && (resource.data.assignedTo == request.auth.uid || resource.data.assignedStaffId == request.auth.uid))
        || (isActiveUser() && resource.data.customerId == request.auth.uid)
        // Assigned/participant field staff (e.g. a checker holding custody) may
        // read the shipment conversation they belong to.
        || (
          isActiveUser()
          && resource.data.get('type', '') != 'direct_staff'
          && request.auth.uid in resource.data.get('participantIds', [])
        );

      allow list: if isAdmin()
        || managerCanAccessConversation(resource.data)
        || canListParticipantConversation(resource.data)
        || canReadOwnedConversation(resource.data)
        || (hasRole('employee') && (resource.data.assignedTo == request.auth.uid || resource.data.assignedStaffId == request.auth.uid))
        || (hasRole('customer') && resource.data.customerId == request.auth.uid);

      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin()
          || managerCanAccessConversation(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
          )
          || canReadDirectStaffConversation(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
          )
          || canReadOwnedConversation(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
          )
          || (
            hasRole('customer')
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid
          )
          || (
            hasRole('employee')
            && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.assignedTo == request.auth.uid || get(/databases/$(database)/documents/conversations/$(conversationId)).data.assignedStaffId == request.auth.uid)
          )
          || (
            isActiveUser()
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('type', '') != 'direct_staff'
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participantIds', [])
          );

        allow create, update, delete: if false;
      }
    }

    // --- CALLS / SUPPORT ---

    match /calls/{callId} {
      allow get: if isSignedIn() && callDriverAssignmentIsCurrent(resource.data) && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.callerId == request.auth.uid ||
        (resource.data.ringingReceiverIds is list && request.auth.uid in resource.data.ringingReceiverIds) ||
        isAdmin()
      );
      allow list: if isSignedIn() && callDriverAssignmentIsCurrent(resource.data) && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.callerId == request.auth.uid ||
        (resource.data.ringingReceiverIds is list && request.auth.uid in resource.data.ringingReceiverIds) ||
        isAdmin()
      );
      allow create: if false;
      allow update: if isSignedIn() && callDriverAssignmentIsCurrent(resource.data) && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.callerId == request.auth.uid ||
        (resource.data.ringingReceiverIds is list && request.auth.uid in resource.data.ringingReceiverIds)
      );
      allow delete: if false;
    }

    // --- OPERATIONS ---

    match /shipments/{shipmentId} {
      allow get: if isAdmin() || managerCanAccessOperation(resource.data) || hasRole('checker') || driverCanReadShipmentData(resource.data) || customerOwnsShipment();
      allow list: if isAdmin() || managerCanAccessOperation(resource.data) || hasRole('checker') || driverCanReadShipmentData(resource.data)
        || customerOwnsShipment()
        || (
          hasRole('customer')
          && request.auth.uid in resource.data.get('visibilityUserIds', [])
        );
      allow create, update, delete: if false;

      match /status_events/{statusId} {
        allow read: if isAdmin() || managerCanAccessOperation(
          get(/databases/$(database)/documents/shipments/$(shipmentId)).data
        ) || hasRole('checker') || driverCanReadShipmentData(
          get(/databases/$(database)/documents/shipments/$(shipmentId)).data
        );
        allow create, update, delete: if false;
      }

      match /packages/{packageId} {
        allow get: if isAdmin() || managerCanAccessOperation(
          get(/databases/$(database)/documents/shipments/$(shipmentId)).data
        ) || hasRole('checker') || driverCanReadShipmentData(
          get(/databases/$(database)/documents/shipments/$(shipmentId)).data
        ) || customerOwnsShipment();
        allow list: if isAdmin() || managerCanAccessOperation(
          get(/databases/$(database)/documents/shipments/$(shipmentId)).data
        ) || hasRole('checker') || driverCanReadShipmentData(
          get(/databases/$(database)/documents/shipments/$(shipmentId)).data
        )
          || customerOwnsShipment()
          || (
            hasRole('customer')
            && request.auth.uid in get(/databases/$(database)/documents/shipments/$(shipmentId)).data.get('visibilityUserIds', [])
          );
        allow create, update, delete: if false;
      }

      match /invoices/{invoiceId} {
        allow get: if isAdmin() || managerCanAccessOperation(
          get(/databases/$(database)/documents/shipments/$(shipmentId)).data
        ) || hasRole('checker') || driverCanReadShipmentData(
          get(/databases/$(database)/documents/shipments/$(shipmentId)).data
        ) || customerOwnsShipment();
        allow list: if isAdmin() || managerCanAccessOperation(
          get(/databases/$(database)/documents/shipments/$(shipmentId)).data
        ) || hasRole('checker') || driverCanReadShipmentData(
          get(/databases/$(database)/documents/shipments/$(shipmentId)).data
        ) || customerOwnsShipment();
        allow create, update, delete: if false;
      }
    }

    match /tracking_records/{trackingNumber} {
      allow read: if isAdmin() || managerCanAccessOperation(resource.data) || hasRole('checker');
      allow write: if false;

      match /status_events/{statusId} {
        allow read: if isAdmin() || managerCanAccessOperation(
          get(/databases/$(database)/documents/tracking_records/$(trackingNumber)).data
        ) || hasRole('checker');
        allow write: if false;
      }
    }

    match /truck_trips/{tripId} {
      allow read: if isAdmin() || managerCanAccessOperation(resource.data) ||
        hasRole('checker') ||
        (hasRole('driver') && isAssignedDriver());
      allow create, update, delete: if false;

      match /trip_shipments/{shipmentId} {
        allow read: if isAdmin() || managerCanAccessOperation(
          get(/databases/$(database)/documents/truck_trips/$(tripId)).data
        ) || hasRole('checker') || (
          hasRole('driver') &&
          get(/databases/$(database)/documents/truck_trips/$(tripId)).data.get('driverId', null) == request.auth.uid
        );
        allow create, update, delete: if false;
      }

      match /trip_packages/{packageId} {
        allow read: if isAdmin() || managerCanAccessOperation(
          get(/databases/$(database)/documents/truck_trips/$(tripId)).data
        ) || hasRole('checker') || (
          hasRole('driver') &&
          get(/databases/$(database)/documents/truck_trips/$(tripId)).data.get('driverId', null) == request.auth.uid
        );
        allow create, update, delete: if false;
      }

      match /manifest_amendments/{amendmentId} {
        allow read: if isAdmin() || managerCanAccessOperation(
          get(/databases/$(database)/documents/truck_trips/$(tripId)).data
        );
        allow create, update, delete: if false;
      }

      match /manifest_events/{eventId} {
        allow read: if isAdmin() || managerCanAccessOperation(
          get(/databases/$(database)/documents/truck_trips/$(tripId)).data
        );
        allow create, update, delete: if false;
      }
    }

    // Custody event ledger (append-only via Cloud Functions)
    match /shipment_events/{eventId} {
      allow read: if isAdmin() || (
        resource.data.get('shipmentId', '') != ''
        && managerCanAccessOperation(
          get(/databases/$(database)/documents/shipments/$(resource.data.shipmentId)).data
        )
      ) || hasRole('checker') || (
        hasRole('driver')
        && resource.data.get('shipmentId', '') != ''
        && driverCanReadShipmentData(
          get(/databases/$(database)/documents/shipments/$(resource.data.shipmentId)).data
        )
      );
      allow create, update, delete: if false;
    }

    match /delivery_manifests/{manifestId} {
      allow read: if canReadDeliveryManifest();
      allow create, update, delete: if false;
    }

    // Sealed linehaul manifests and amendments (server-written; staff read)
    match /manifests/{manifestId} {
      allow read: if isAdmin() || managerCanAccessOperation(resource.data);
      allow create, update, delete: if false;
    }

    match /manifest_amendments/{amendmentId} {
      allow read: if isAdmin() || managerCanAccessOperation(resource.data);
      allow create, update, delete: if false;
    }

    // --- BILLING ---

    match /invoices/{invoiceId} {
      allow read: if isAdmin() || managerCanAccessOperation(resource.data) || hasRole('checker');
      allow create, update, delete: if false;
    }

    match /invoice_events/{eventId} {
      allow read: if isAdmin() || managerCanAccessOperation(resource.data);
      allow create, update, delete: if false;
    }

    match /shipmentPayments/{paymentId} {
      allow read: if isAdmin() || managerCanAccessOperation(resource.data);
      allow create, update, delete: if false;
    }

    match /financeEventOutbox/{eventId} {
      allow read, write: if false;
    }

    match /paymentRequestReservations/{reservationId} {
      allow read, write: if false;
    }

    match /paymentReferenceReservations/{reservationId} {
      allow read, write: if false;
    }

    match /shipmentInvoiceReservations/{reservationId} {
      allow read, write: if false;
    }

    // --- PUBLIC TRACKING ---

    match /tracking_public/{trackingNumber} {
      allow read: if true;
      allow write: if false;
    }

    match /app_settings/{settingsId} {
      allow get: if settingsId == 'operational';
      allow list: if false;
      allow write: if false;
    }

    // --- ALERTS AND LOGS ---

    match /admin_alerts/{alertId} {
      allow read: if isAdmin() || managerCanAccessOperation(resource.data);
      allow update: if (isAdmin() || managerCanAccessOperation(resource.data))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'readAt'])
        && request.resource.data.status in ['UNREAD', 'READ'];
      allow create, delete: if false;
    }

    match /sms_logs/{smsId} {
      allow read: if isAdmin() || managerCanAccessOperation(resource.data);
      allow write: if false;
    }

    match /notificationLogs/{logId} {
      allow read: if isAdmin() || managerCanAccessOperation(resource.data);
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if hasRole('admin');
      allow write: if false;
    }

    match /audit_events/{eventId} {
      allow read: if hasRole('admin');
      allow write: if false;
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin() || managerCanAccessOperation(resource.data);
      allow write: if false;
    }

    match /routes/{routeId} {
      allow read: if isAdmin() || managerCanAccessOperation(resource.data) || hasRole('checker');
      allow write: if false;
    }

    match /daily_route_assignments/{assignmentId} {
      allow read: if isAdmin() || managerCanAccessOperation(resource.data) || hasRole('checker');
      allow write: if false;
    }

    match /scan_audit_logs/{logId} {
      allow read: if isAdmin() || (
        resource.data.get('shipmentId', '') != ''
        && managerCanAccessOperation(
          get(/databases/$(database)/documents/shipments/$(resource.data.shipmentId)).data
        )
      );
      allow write: if false;
    }
  }
}

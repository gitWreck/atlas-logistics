rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userDocPath());
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(userDocPath())
        && userDoc().data.get('active', true) != false;
    }

    function userRole() {
      return userDoc().data.get('role', '').lower();
    }

    function hasRole(role) {
      return isActiveUser() && userRole() == role.lower();
    }

    function hasAnyRole(roles) {
      return isActiveUser() && userRole() in roles;
    }

    function isStaff() {
      return hasAnyRole(['admin', 'manager', 'checker', 'driver']);
    }

    function isAdminOrManager() {
      return hasAnyRole(['admin', 'manager']);
    }

    function isAssignedDriver() {
      return resource.data.driverId == request.auth.uid ||
        resource.data.assignedDriverId == request.auth.uid;
    }

    function customerOwnsShipment() {
      return hasRole('customer') && (
        resource.data.get('sender', {}).get('uid', null) == request.auth.uid ||
        resource.data.get('recipient', {}).get('uid', null) == request.auth.uid ||
        resource.data.get('createdBy', null) == request.auth.uid ||
        resource.data.get('customerId', null) == request.auth.uid
      );
    }

    function canReadDeliveryManifest() {
      return isAdminOrManager() ||
        (hasRole('checker') && resource.data.checkerId == request.auth.uid);
    }

    function canReadUserProfile(userId) {
      return isSignedIn() && (
        (
          request.auth.uid == userId
          && (!exists(userDocPath()) || userDoc().data.get('active', true) != false)
        ) ||
        isActiveUser() && hasAnyRole(['admin', 'manager'])
      );
    }

    function checkerChatAccessToken() {
      return request.auth.uid + ':' + userDoc().data.get('checkerChatAccessKey', '__missing__');
    }

    function canReadDirectStaffConversation(conversation) {
      return isActiveUser()
        && conversation.get('type', '') == 'direct_staff'
        && request.auth.uid in conversation.get('participantIds', [])
        && (
          userRole() != 'checker'
          || checkerChatAccessToken() in conversation.get('checkerAccessTokens', [])
        );
    }

    function canListParticipantConversation(conversation) {
      return isActiveUser()
        && request.auth.uid in conversation.get('participantIds', []);
    }

    // Customer signup currently performs duplicate checks before auth.
    // Keep this tightly limited; moving this check behind a callable/API is safer.
    function isCustomerSignupDuplicateQuery() {
      return !isSignedIn()
        && request.query.limit != null
        && request.query.limit <= 1;
    }

    // --- USERS ---

    match /users/{userId} {
      allow get: if canReadUserProfile(userId);
      allow list: if canReadUserProfile(userId) || isCustomerSignupDuplicateQuery();

      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isActiveUser() && (
        request.auth.uid == userId ||
        isAdminOrManager()
      );
      allow delete: if hasRole('admin');

      // Canonical path used by addTrackedShipment.
      match /tracked_shipments/{trackingNumber} {
        allow read, write: if isActiveUser() && request.auth.uid == userId;
      }

      // Legacy path kept until existing data is migrated.
      match /trackedShipments/{trackingNumber} {
        allow read, write: if isActiveUser() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read: if isActiveUser()
          && request.auth.uid == userId
          && resource.data.get('ownerId', userId) == request.auth.uid;
        allow update: if isActiveUser()
          && request.auth.uid == userId
          && resource.data.get('ownerId', userId) == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }

      match /pushTokens/{tokenId} {
        allow read, create, update, delete: if isActiveUser() && request.auth.uid == userId;
      }
    }

    // --- CUSTOMER SUPPORT CHAT ---

    match /conversations/{conversationId} {
      allow get: if hasRole('admin')
        || canReadDirectStaffConversation(resource.data)
        || (isActiveUser() && resource.data.customerId == request.auth.uid)
        || (hasRole('manager') && (resource.data.assignedTo == request.auth.uid || resource.data.assignedStaffId == request.auth.uid))
        || (hasRole('employee') && (resource.data.assignedTo == request.auth.uid || resource.data.assignedStaffId == request.auth.uid));

      allow list: if hasRole('admin')
        || canListParticipantConversation(resource.data)
        || (hasRole('customer') && resource.data.customerId == request.auth.uid)
        || (hasRole('manager') && (resource.data.assignedTo == request.auth.uid || resource.data.assignedStaffId == request.auth.uid))
        || (hasRole('employee') && (resource.data.assignedTo == request.auth.uid || resource.data.assignedStaffId == request.auth.uid));

      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if hasRole('admin')
          || canReadDirectStaffConversation(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
          )
          || (
            hasRole('customer')
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid
          )
          || (
            hasRole('manager')
            && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.assignedTo == request.auth.uid || get(/databases/$(database)/documents/conversations/$(conversationId)).data.assignedStaffId == request.auth.uid)
          )
          || (
            hasRole('employee')
            && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.assignedTo == request.auth.uid || get(/databases/$(database)/documents/conversations/$(conversationId)).data.assignedStaffId == request.auth.uid)
          )
          || (
            isActiveUser()
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('type', '') != 'direct_staff'
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participantIds', [])
          );

        allow create, update, delete: if false;
      }
    }

    // --- CALLS / SUPPORT ---

    match /calls/{callId} {
      allow get: if isSignedIn() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.callerId == request.auth.uid ||
        isAdminOrManager()
      );
      allow list: if isSignedIn() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.callerId == request.auth.uid ||
        isAdminOrManager()
      );
      allow create: if false;
      allow update: if isSignedIn() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.callerId == request.auth.uid ||
        isAdminOrManager()
      );
      allow delete: if false;
    }

    // --- OPERATIONS ---

    match /shipments/{shipmentId} {
      allow get: if isStaff() || customerOwnsShipment();
      allow list: if isStaff()
        || customerOwnsShipment()
        || (
          hasRole('customer')
          && request.auth.uid in resource.data.get('visibilityUserIds', [])
        );
      allow create, update, delete: if false;

      match /status_events/{statusId} {
        allow read: if isStaff();
        allow create, update, delete: if false;
      }

      match /packages/{packageId} {
        allow get: if isStaff() || customerOwnsShipment();
        allow list: if isStaff()
          || customerOwnsShipment()
          || (
            hasRole('customer')
            && request.auth.uid in get(/databases/$(database)/documents/shipments/$(shipmentId)).data.get('visibilityUserIds', [])
          );
        allow create, update, delete: if false;
      }

      match /invoices/{invoiceId} {
        allow get: if isStaff() || customerOwnsShipment();
        allow list: if isStaff() || customerOwnsShipment() || isAdminOrManager();
        allow create, update, delete: if false;
      }
    }

    match /tracking_records/{trackingNumber} {
      allow read: if isStaff();
      allow write: if false;

      match /status_events/{statusId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    match /truck_trips/{tripId} {
      allow read: if isAdminOrManager() ||
        hasRole('checker') ||
        (hasRole('driver') && isAssignedDriver());
      allow create, update, delete: if false;

      match /trip_shipments/{shipmentId} {
        allow read: if isStaff();
        allow create, update, delete: if false;
      }

      match /trip_packages/{packageId} {
        allow read: if isStaff();
        allow create, update, delete: if false;
      }

      match /manifest_amendments/{amendmentId} {
        allow read: if isAdminOrManager();
        allow create, update, delete: if false;
      }

      match /manifest_events/{eventId} {
        allow read: if isAdminOrManager();
        allow create, update, delete: if false;
      }
    }

    // Custody event ledger (append-only via Cloud Functions)
    match /shipment_events/{eventId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /delivery_manifests/{manifestId} {
      allow read: if canReadDeliveryManifest();
      allow create, update, delete: if false;
    }

    // Sealed linehaul manifests and amendments (server-written; staff read)
    match /manifests/{manifestId} {
      allow read: if isAdminOrManager();
      allow create, update, delete: if false;
    }

    match /manifest_amendments/{amendmentId} {
      allow read: if isAdminOrManager();
      allow create, update, delete: if false;
    }

    // --- BILLING ---

    match /invoices/{invoiceId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /invoice_events/{eventId} {
      allow read: if isAdminOrManager();
      allow create, update, delete: if false;
    }

    // --- PUBLIC TRACKING ---

    match /tracking_public/{trackingNumber} {
      allow read: if true;
      allow write: if false;
    }

    match /app_settings/{settingsId} {
      allow get: if settingsId == 'operational';
      allow list: if false;
      allow write: if false;
    }

    // --- ALERTS AND LOGS ---

    match /admin_alerts/{alertId} {
      allow read: if isAdminOrManager();
      allow update: if isAdminOrManager()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'readAt'])
        && request.resource.data.status in ['UNREAD', 'READ'];
      allow create, delete: if false;
    }

    match /sms_logs/{smsId} {
      allow read: if isAdminOrManager();
      allow write: if false;
    }

    match /notificationLogs/{logId} {
      allow read: if isAdminOrManager();
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if hasRole('admin');
      allow write: if false;
    }

    match /audit_events/{eventId} {
      allow read: if hasRole('admin');
      allow write: if false;
    }

    match /admin_logs/{logId} {
      allow read: if isAdminOrManager();
      allow write: if false;
    }

    match /routes/{routeId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /daily_route_assignments/{assignmentId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /scan_audit_logs/{logId} {
      allow read: if isAdminOrManager();
      allow write: if false;
    }
  }
}

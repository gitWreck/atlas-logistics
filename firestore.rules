rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check user role from custom claims or a 'users' collection
    // (Assuming you store roles in a 'users' collection for this phase)
    function hasRole(role) {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Check if the user is the specific driver assigned to the trip
    function isAssignedDriver() {
      return resource.data.driverId == request.auth.uid;
    }

    // --- COLLECTIONS ---

    // 1. USER PROFILES + CUSTOMER-TRACKED SHIPMENTS
    match /users/{userId} {
      // Base user profile document
      allow read: if isSignedIn(); // Users can read profiles (or restrict to own/admin)
      allow write: if request.auth.uid == userId || hasRole('admin');

      // Per-user tracked shipments for customers
      match /trackedShipments/{trackingNumber} {
        // Customers can only manage their own tracked shipments
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 2. INTERNAL TRUTH: TRACKING RECORDS
    // Contains sensitive customer data. STRICTLY INTERNAL.
    match /tracking_records/{trackingNumber} {
      // READ: Admins, Managers, and Checkers can see details. 
      // Drivers might need to see packages on their manifest.
      allow read: if hasRole('admin') || hasRole('manager') || hasRole('checker') || hasRole('driver');
      
      // WRITE: DENY ALL. 
      // Mandate: "All critical actions must go through Cloud Functions"
      // This forces your Next.js app to use Server Actions/Cloud Functions to modify data.
      allow write: if false; 
    }

    // 3. TRIPS (Physical Truck Runs)
    match /truck_trips/{tripId} {
      // READ: Managers and the assigned Driver.
      allow read: if hasRole('admin') || hasRole('manager') || (hasRole('driver') && isAssignedDriver());
      
      // WRITE: DENY ALL. 
      // Trip creation, locking, and status updates go through Cloud Functions.
      allow write: if false;
    }

    // 4. PUBLIC PROJECTION
    // The ONLY place the public can look.
    match /tracking_public/{trackingNumber} {
      // READ: Open to the world (or restrict to those with the tracking # if you prefer)
      allow read: if true;
      
      // WRITE: DENY ALL. 
      // Only the "Projection" Cloud Function can write here.
      allow write: if false;
    }
    
    // 5. LOGS (Audit Trail)
    match /audit_logs/{logId} {
      allow read: if hasRole('admin');
      allow write: if false; // Only written by backend
    }
  }
}
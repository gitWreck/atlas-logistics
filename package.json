{
  "name": "atlas-trucking-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "nohoist": [
    "**/react-native",
    "**/react-native/**"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "functions:check": "npm run lint --workspace=apps/functions",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:functions:manifest": "firebase deploy --only functions:unlockTripManifest,functions:manualAssignShipmentToTrip,functions:bulkAssignShipments,functions:assignShipmentToTrip,functions:generateTripManifest"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "dependencies": {
    "caniuse-lite": "^1.0.30001806",
    "expo": "^53.0.14",
    "next": "^16.2.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "xlsx": "^0.18.5"
  }
}
